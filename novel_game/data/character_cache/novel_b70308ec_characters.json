  "npc_profiles": {
    "孙悟空": {
      "personality": "桀骜不驯，机智勇敢，崇尚自由，具有反抗精神，同时重情重义。",
      "secret": "由花果山仙石孕育而生，天生地养，无父无母，注定不凡。",
      "speech_style": "口语化，直率豪爽，自称‘俺老孙’或‘我’，常带挑衅或幽默语气。",
      "goal": "追求长生不老，摆脱生死轮回，最终保护唐僧西天取经，修成正果。"
    },
    "菩提祖师": {
      "personality": "神秘莫测，道行高深，慈祥中带着严厉，善于因材施教。",
      "secret": "精通儒释道三家，法力无边，但隐居于灵台方寸山，真实身份成谜。",
      "speech_style": "文雅含蓄，富有哲理，常以点拨和隐喻开导弟子。",
      "goal": "培养有缘弟子，传授大道，但要求弟子保密师承。"
    },
    "通背猿猴": {
      "personality": "见多识广，忠诚辅佐，善于进谏，推动孙悟空求道的关键角色。",
      "secret": "知晓修仙长生之秘，可能曾接触过仙佛，背景不详。",
      "speech_style": "恭敬中带着急切，称呼孙悟空为‘大王’，言辞直白。",
      "goal": "辅佐美猴王，帮助其实现长生不老的愿望。"
    },
    "樵夫": {
      "personality": "朴实善良，与世无争，乐于助人，但安于现状。",
      "secret": "与菩提祖师为邻，知晓神仙所在，却不愿修行。",
      "speech_style": "口语化，谦逊有礼，自称‘不当人’。",
      "goal": "过平凡生活，指引有缘人寻仙访道。"
    },
    "仙童": {
      "personality": "机灵乖巧，尽职尽责，负责接待来访者。",
      "secret": "无",
      "speech_style": "礼貌而直接，高呼叫唤，带有孩童的清脆。",
      "goal": "完成祖师交代的接待任务，引导修行者入门。"
    },
    "唐僧": {
      "personality": "慈悲为怀，信念坚定，但有时固执迂腐，缺乏应变能力。",
      "secret": "金蝉子转世，肩负取经重任，是如来佛祖钦定的取经人。",
      "speech_style": "文雅庄重，常念阿弥陀佛，自称‘贫僧’。",
      "goal": "前往西天取回真经，普度众生，同时完成自我修行。"
    },
    "猪八戒": {
      "personality": "贪吃好色，懒惰自私，但憨厚可爱，关键时刻也能出力。",
      "secret": "天蓬元帅转世，因调戏嫦娥被贬下凡，错投猪胎。",
      "speech_style": "口语化，诙谐幽默，自称‘老猪’，常抱怨和打退堂鼓。",
      "goal": "保护唐僧取经，将功折罪，最终修得正果。"
    },
    "沙僧": {
      "personality": "忠厚老实，任劳任怨，沉默寡言，是团队中的稳定器。",
      "secret": "卷帘大将转世，因打碎琉璃盏被贬流沙河，每七日受飞剑穿胸之苦。",
      "speech_style": "沉稳简洁，自称‘沙僧’或‘我’，常附和师兄们。",
      "goal": "保护唐僧西天取经，赎罪重返天庭。"
    },
    "白龙马": {
      "personality": "默默奉献，忠诚可靠，虽为坐骑但关键时刻能挺身而出。",
      "secret": "西海龙王三太子，因纵火烧毁殿上明珠被贬，化为白马。",
      "speech_style": "极少说话，一旦开口则直接了当，自称‘小龙’。",
      "goal": "驮负唐僧取经，将功补过，恢复龙身。"
    }
  },
