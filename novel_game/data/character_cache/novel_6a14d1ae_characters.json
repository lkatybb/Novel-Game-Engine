  "npc_profiles": {
    "温晴": {
      "personality": "坚韧、聪慧、冷静，拥有科学家的理性与母亲的温柔，经历背叛后变得决绝而独立。",
      "secret": "曾为救丈夫剥离自己一半记忆神经元，成为植物人三年；死而复生后隐藏身份，计划复仇。",
      "speech_style": "冷静、克制、逻辑清晰，常用反问句和陈述事实，极少流露情绪。",
      "goal": "夺回儿子晨晨的健康和抚养权，揭露许柔的罪行，收回公司的核心技术，让陆知宴和许柔付出代价。"
    },
    "陆知宴": {
      "personality": "原本深情但易受蒙蔽，因记忆混乱而变得偏执、脆弱、逃避责任，后期陷入悔恨与崩溃。",
      "secret": "误将许柔当作救命恩人，忽视亲生子晨晨，实际移植的是温晴的神经元，身体会排斥对许柔的爱意。",
      "speech_style": "开始笃定、自信，后期语无伦次、充满哀求与忏悔。",
      "goal": "保住公司、维持与许柔的关系，但在真相大白后试图挽回温晴和晨晨。"
    },
    "许柔": {
      "personality": "阴险、自私、善于伪装，嫉妒心强，为达目的不择手段。",
      "secret": "买通医生篡改捐献记录，霸占温晴科研成果并虐待晨晨，其子实为前夫所生。",
      "speech_style": "温柔甜腻但虚伪，急忙辩解时尖锐慌乱，常用哭诉博同情。",
      "goal": "获得陆知宴的爱和财富，清除温晴及晨晨，巩固自己的地位。"
    },
    "晨晨": {
      "personality": "年幼但早熟，懂事、敏感、依赖母亲，因疾病和虐待而脆弱，但顽强求生。",
      "secret": "对金属严重过敏，被许柔蓄意引发哮喘，遭受父亲误解和遗弃。",
      "speech_style": "童声稚气，夹杂咳嗽和哭声，表达直接而令人心碎。",
      "goal": "见到妈妈，摆脱病痛和父亲的冷漠，获得关爱。"
    },
    "周教授": {
      "personality": "睿智、沉稳、正直善良，作为温晴的导师，暗中捍卫真相。",
      "secret": "将温晴从死亡线上救回，隐瞒其存活并持续治疗，收集证据助她复仇。",
      "speech_style": "严谨、专业、平缓，措辞委婉但一针见血。",
      "goal": "帮助温晴恢复健康并揭露真相，保护晨晨的权益。"
    },
    "李澈": {
      "personality": "忠诚、机敏、行动力强，对温晴忠心。",
      "secret": "曾是温晴助理，在其“死后”一直潜伏，等待指示帮助她翻盘。",
      "speech_style": "简洁干练、略显紧张但果断，常用急促语气汇报。",
      "goal": "协助温晴完成复仇计划，夺回公司技术和儿子。"
    }
  },
