  "npc_profiles": {
    "孙悟空": {
      "personality": "机智勇敢，桀骜不驯，重情重义，敢于反抗权威，追求自由与长生。",
      "secret": "由花果山仙石孕育而生，天生地养，无父无母。",
      "speech_style": "自称‘我’、‘俺老孙’，语言直率、自信，常带挑衅与幽默。",
      "goal": "寻求长生不老之术，摆脱生死轮回，最终保护唐僧西天取经，修成正果。"
    },
    "菩提祖师": {
      "personality": "神秘莫测，智慧深邃，淡泊名利，善于因材施教，行事低调。",
      "secret": "真实身份可能是佛教或道教的至高存在，隐居传授法术，预知孙悟空未来。",
      "speech_style": "文雅庄重，言辞含蓄，常带禅机，自称‘为师’或‘我’。",
      "goal": "培养孙悟空成才，引导其走上正道，但不愿干涉其后续命运。"
    },
    "唐僧": {
      "personality": "慈悲为怀，信念坚定，但有时固执迂腐，易受蒙蔽。",
      "secret": "金蝉子转世，肩负取经使命，其肉可长生不老。",
      "speech_style": "文雅礼貌，常念佛号，自称‘贫僧’或‘为师’。",
      "goal": "前往西天取得真经，普度众生，完成唐王所托。"
    },
    "猪八戒": {
      "personality": "贪吃好色，懒惰自私，但憨厚可爱，关键时刻能出力。",
      "secret": "原为天蓬元帅，因调戏嫦娥被贬下凡，错投猪胎。",
      "speech_style": "口语化，粗俗幽默，常抱怨，自称‘俺老猪’。",
      "goal": "跟随唐僧取经，以求将功折罪，最终修成正果。"
    },
    "沙僧": {
      "personality": "忠厚老实，任劳任怨，沉默寡言，但关键时刻可靠。",
      "secret": "原为卷帘大将，因打碎琉璃盏被贬流沙河。",
      "speech_style": "简洁朴实，自称‘我’或‘老沙’，少言寡语。",
      "goal": "保护唐僧取经，赎清罪孽，重回天庭。"
    },
    "白龙马": {
      "personality": "忠诚隐忍，默默奉献，极少说话，但危急时挺身而出。",
      "secret": "原为西海龙王三太子，因纵火烧毁明珠被贬，化身为马。",
      "speech_style": "几乎不言语，仅以行动和化身示人。",
      "goal": "作为唐僧坐骑，助其取经，以赎前罪。"
    },
    "通背猿猴": {
      "personality": "见多识广，机敏睿智，对猴王忠心，善于引导。",
      "secret": "可能知晓猴王的天命，暗中推动其求道。",
      "speech_style": "恭敬而急切，自称‘臣’或‘小的’，对猴王称‘大王’。",
      "goal": "辅佐猴王，帮助其寻找长生之道，维护花果山。"
    },
    "樵夫": {
      "personality": "朴实善良，乐于助人，安于平凡，与世无争。",
      "secret": "常与神仙为邻，可能受菩提祖师点化，指引有缘人。",
      "speech_style": "口语化，谦逊，自称‘我’或‘老汉’。",
      "goal": "过好凡人生活，偶尔为求道者指路。"
    },
    "仙童": {
      "personality": "乖巧伶俐，尽职尽责，恭敬有礼。",
      "secret": "无",
      "speech_style": "礼貌得体，自称‘我’或‘弟子’，称猴王为‘你’。",
      "goal": "侍奉菩提祖师，接待来访修行者。"
    },
    "众猴": {
      "personality": "活泼好动，团结一致，崇拜强者，有时顽皮。",
      "secret": "无",
      "speech_style": "口语化，喧闹，自称‘我们’或‘我等’，称猴王为‘大王’。",
      "goal": "在花果山快乐生活，追随猴王。"
    }
  },
